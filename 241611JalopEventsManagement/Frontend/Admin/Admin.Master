<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="_241611JalopEventsManagement.Frontend.Admin.Admin" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">University Admin Portal</asp:ContentPlaceHolder></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Enterprise Global Stylesheet & Design Tokens -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/Frontend/Assets/css/global.css?v=20261006-no-dots") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Frontend/Assets/css/toast.css") %>" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="adminMasterForm" runat="server" enctype="multipart/form-data">
        <div class="admin-layout">
            <!-- Sidebar Navigation Shell -->
            <aside class="admin-sidebar">
                <a href="<%= ResolveUrl("~/Frontend/Admin/AdminEvents.aspx") %>" class="sidebar-brand">
                    <img src="<%= ResolveUrl("~/Frontend/Assets/QCU Logo.png") %>" alt="QCU Emblem" class="brand-logo-img" />
                    <div class="brand-text">
                        <h1>QCU Admin</h1>
                        <span>Events Console</span>
                    </div>
                </a>

                <nav class="sidebar-nav">
                    <!-- Core Section -->
                    <div>
                        <div class="nav-group-title">Core Management</div>
                        <ul class="nav-list">
                            <li class="nav-item <%= Request.Path.EndsWith("AdminEvents.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/AdminEvents.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <span>Events Matrix</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("CreateEvent.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/CreateEvent.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="16"></line>
                                        <line x1="8" y1="12" x2="16" y2="12"></line>
                                    </svg>
                                    <span>Create Event</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("EventHistory.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/EventHistory.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M12 8v4l3 3"></path>
                                        <circle cx="12" cy="12" r="9"></circle>
                                    </svg>
                                    <span>Events History</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Operations Section -->
                    <div>
                        <div class="nav-group-title">Attendance & Users</div>
                        <ul class="nav-list">
                            <%-- Hidden from navigation per user request
                            <li class="nav-item <%= Request.Path.EndsWith("EventPreRegistered.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/EventPreRegistered.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="8.5" cy="7" r="4"></circle>
                                        <polyline points="17 11 19 13 23 9"></polyline>
                                    </svg>
                                    <span>Pre-Registered</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("AttendanceScanner.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/AttendanceScanner.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3M9 9h6v6H9z"></path>
                                    </svg>
                                    <span>Attendance Scanner</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("EventAttendance.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/EventAttendance.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M9 11l3 3L22 4"></path>
                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                    </svg>
                                    <span>Event Attendance</span>
                                </a>
                            </li>
                            --%>
                            <li class="nav-item <%= Request.Path.EndsWith("StudentList.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/StudentList.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    <span>Student Directory</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("AccountManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/AccountManagement.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                    <span>Account Management</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                </nav>

                <!-- Sidebar Footer Profile Block -->
                <div class="sidebar-footer">
                    <div class="user-avatar">
                        <asp:Literal ID="litAvatarInitials" runat="server" Text="AD" />
                    </div>
                    <div class="user-info">
                        <div class="user-name">
                            <asp:Literal ID="litAdminEmail" runat="server" Text="admin@university.edu" />
                        </div>
                        <div class="user-role">

                            <span>Administrator</span>
                        </div>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click" ToolTip="Sign Out" CausesValidation="false">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </asp:LinkButton>
                </div>
            </aside>

            <!-- Main Working Area -->
            <div class="admin-main-wrapper">
                <!-- Topbar Header -->
                <header class="admin-topbar">
                    <div class="topbar-left">
                        <span class="topbar-title">University Event Management</span>
                        <!--<div class="topbar-campus-tag">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Main Campus • Central Portal</span>
                        </div>-->
                    </div>
                </header>

                <!-- Injected Child Content -->
                <main class="admin-workspace">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>

        <!-- High-Performance Navigation Progress Indicator -->
        <div id="adminNavBar" style="position: fixed; top: 0; left: 0; height: 3px; width: 0; background: linear-gradient(90deg, #3b82f6, #6366f1, #10b981); z-index: 99999; transition: width 0.25s ease-out; pointer-events: none; opacity: 0;"></div>

        <!-- Enterprise Floating Lower-Right Toast Container -->
        <div id="appToastContainer" class="app-toast-container" aria-live="polite" aria-atomic="true"></div>
    </form>

    <!-- Universal Toast Engine -->
    <script type="text/javascript" src="<%= ResolveUrl("~/Frontend/Assets/js/toast.js") %>"></script>

    <!-- Instant Page Prefetcher & Zero-Lag Transition Engine -->
    <script type="text/javascript">
        (function () {
            var prefetched = {};
            function prefetch(url) {
                if (!url || prefetched[url] || url.indexOf('Logout') !== -1 || url.indexOf('#') !== -1 || url.indexOf('javascript:') === 0) return;
                prefetched[url] = true;
                var link = document.createElement('link');
                link.rel = 'prefetch';
                link.href = url;
                link.as = 'document';
                document.head.appendChild(link);
            }

            document.addEventListener('mouseover', function (e) {
                var a = e.target.closest('a');
                if (a && a.href && a.origin === window.location.origin && a.target !== '_blank') {
                    prefetch(a.href);
                }
            }, { passive: true });

            document.addEventListener('touchstart', function (e) {
                var a = e.target.closest('a');
                if (a && a.href && a.origin === window.location.origin && a.target !== '_blank') {
                    prefetch(a.href);
                }
            }, { passive: true });

            var bar = document.getElementById('adminNavBar');
            document.addEventListener('click', function (e) {
                var a = e.target.closest('a');
                if (a && a.href && a.origin === window.location.origin && !a.href.startsWith('#') && !a.href.startsWith('javascript:') && a.target !== '_blank') {
                    if (bar) {
                        bar.style.opacity = '1';
                        bar.style.width = '70%';
                    }
                }
            }, { passive: true });

            window.addEventListener('pageshow', function () {
                if (bar) {
                    bar.style.width = '100%';
                    setTimeout(function () {
                        bar.style.opacity = '0';
                        bar.style.width = '0';
                    }, 180);
                }
            });
        })();
    </script>
</body>
</html>
