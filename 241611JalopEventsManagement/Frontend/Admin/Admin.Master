<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="_241611JalopEventsManagement.Frontend.Admin.Admin" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">University Admin Portal</asp:ContentPlaceHolder></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-canvas: #090d16;
            --bg-sidebar: #0d1322;
            --bg-card: #131b2e;
            --bg-input: #1a233a;
            --border-subtle: #1e293b;
            --border-focus: #3b82f6;
            --text-heading: #f8fafc;
            --text-body: #cbd5e1;
            --text-muted: #64748b;
            --brand-primary: #2563eb;
            --brand-primary-hover: #1d4ed8;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --accent-rose: #f43f5e;
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --sidebar-width: 260px;
            --topbar-height: 64px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-body);
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* ─── Layout Shell ─── */
        .admin-layout {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* ─── Sidebar ─── */
        .admin-sidebar {
            width: var(--sidebar-width);
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 40;
            transition: transform 0.25s ease;
        }

        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0 1.25rem;
            border-bottom: 1px solid var(--border-subtle);
            text-decoration: none;
        }

        .brand-logo-img {
            width: 36px;
            height: 36px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(37, 99, 235, 0.35));
            flex-shrink: 0;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            background-color: rgba(37, 99, 235, 0.15);
            border: 1px solid rgba(37, 99, 235, 0.35);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #60a5fa;
            flex-shrink: 0;
        }

        .topbar-portal-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.75rem;
            background-color: rgba(37, 99, 235, 0.1);
            border: 1px solid rgba(37, 99, 235, 0.3);
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #93c5fd;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .topbar-portal-link:hover {
            background-color: rgba(37, 99, 235, 0.2);
            color: #ffffff;
            border-color: #3b82f6;
        }

        .brand-text h1 {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .brand-text span {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }

        .sidebar-nav {
            flex: 1;
            padding: 1.25rem 0.75rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .nav-group-title {
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 0.75rem;
            margin-bottom: 0.35rem;
        }

        .nav-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.75rem;
            border-radius: 6px;
            color: var(--text-body);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .nav-item a:hover {
            background-color: rgba(255, 255, 255, 0.04);
            color: var(--text-heading);
        }

        .nav-item.active a {
            background-color: rgba(37, 99, 235, 0.12);
            color: #93c5fd;
            font-weight: 600;
        }

        .nav-icon {
            width: 18px;
            height: 18px;
            stroke-width: 1.7;
            color: var(--text-muted);
            flex-shrink: 0;
            transition: color 0.15s ease;
        }

        .nav-item a:hover .nav-icon,
        .nav-item.active a .nav-icon {
            color: #60a5fa;
        }

        .nav-badge {
            margin-left: auto;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.15rem 0.45rem;
            border-radius: 9999px;
            background-color: rgba(37, 99, 235, 0.2);
            color: #93c5fd;
            border: 1px solid rgba(37, 99, 235, 0.3);
        }

        /* ─── Sidebar Footer ─── */
        .sidebar-footer {
            padding: 1rem 0.85rem;
            border-top: 1px solid var(--border-subtle);
            background-color: rgba(9, 13, 22, 0.5);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #1e293b;
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-heading);
            font-weight: 600;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .user-info {
            flex: 1;
            min-width: 0;
        }

        .user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-heading);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.7rem;
            color: var(--accent-emerald);
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .role-dot {
            width: 6px;
            height: 6px;
            background-color: var(--accent-emerald);
            border-radius: 50%;
            display: inline-block;
        }

        .btn-logout {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.4rem;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s ease, background 0.15s ease;
        }

        .btn-logout:hover {
            color: var(--accent-rose);
            background-color: rgba(244, 63, 94, 0.1);
        }

        /* ─── Main Content Container ─── */
        .admin-main-wrapper {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            min-width: 0;
        }

        /* ─── Topbar ─── */
        .admin-topbar {
            height: var(--topbar-height);
            background-color: rgba(13, 19, 34, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.75rem;
            position: sticky;
            top: 0;
            z-index: 30;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .topbar-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-heading);
            letter-spacing: -0.01em;
        }

        .topbar-campus-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.2rem 0.6rem;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-subtle);
            border-radius: 4px;
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .system-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 600;
            background-color: rgba(16, 185, 129, 0.1);
            color: var(--accent-emerald);
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .system-pill-dot {
            width: 6px;
            height: 6px;
            background-color: var(--accent-emerald);
            border-radius: 50%;
        }

        /* ─── Page Workspace ─── */
        .admin-workspace {
            flex: 1;
            padding: 1.75rem;
            max-width: 1440px;
            width: 100%;
            margin: 0 auto;
        }

        /* ─── Preview Mode Banner ─── */
        .preview-banner {
            background-color: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.25);
            padding: 0.65rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #fde68a;
        }

        .preview-banner a {
            color: #fbbf24;
            font-weight: 600;
            text-decoration: underline;
        }

        @media (max-width: 1024px) {
            :root {
                --sidebar-width: 72px;
            }
            .brand-text, .nav-group-title, .user-info, .nav-item a span, .nav-badge {
                display: none;
            }
            .sidebar-brand {
                justify-content: center;
                padding: 0;
            }
            .nav-item a {
                justify-content: center;
                padding: 0.75rem 0;
            }
            .sidebar-footer {
                justify-content: center;
                padding: 0.75rem 0;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="adminMasterForm" runat="server">
        <div class="admin-layout">
            <!-- Sidebar Navigation Shell -->
            <aside class="admin-sidebar">
                <a href="<%= ResolveUrl("~/Frontend/Admin/Dashboard.aspx") %>" class="sidebar-brand">
                    <img src="<%= ResolveUrl("~/Frontend/Assets/QCU Logo.png") %>" alt="QCU Emblem" class="brand-logo-img" />
                    <div class="brand-text">
                        <h1>QCU Admin</h1>
                        <span>Events Console</span>
                    </div>
                </a>

                <nav class="sidebar-nav">
                    <!-- Core Section -->
                    <div>
                        <div class="nav-group-title">Core Management</div>
                        <ul class="nav-list">
                            <li class="nav-item <%= Request.Path.EndsWith("Dashboard.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/Dashboard.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                                    </svg>
                                    <span>Dashboard Overview</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("AdminEvents.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/AdminEvents.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <span>Events Matrix</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("CreateEvent.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/CreateEvent.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="16"></line>
                                        <line x1="8" y1="12" x2="16" y2="12"></line>
                                    </svg>
                                    <span>Create Event</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Operations Section -->
                    <div>
                        <div class="nav-group-title">Attendance & Users</div>
                        <ul class="nav-list">
                            <li class="nav-item <%= Request.Path.EndsWith("CheckIn.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/CheckIn.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3M9 9h6v6H9z"></path>
                                    </svg>
                                    <span>QR Attendance</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("EventAttendees.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/EventAttendees.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="8.5" cy="7" r="4"></circle>
                                        <polyline points="17 11 19 13 23 9"></polyline>
                                    </svg>
                                    <span>Attendee Roster</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("StudentList.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/StudentList.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    <span>Student Directory</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- System Section -->
                    <div>
                        <div class="nav-group-title">Analytics & System</div>
                        <ul class="nav-list">
                            <li class="nav-item <%= Request.Path.EndsWith("Reports.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/Reports.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    <span>Turnout Analytics</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("AuditLogs.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/AuditLogs.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                        <polyline points="10 9 9 9 8 9"></polyline>
                                    </svg>
                                    <span>Audit Logs</span>
                                </a>
                            </li>
                            <li class="nav-item <%= Request.Path.EndsWith("TestConnection.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">
                                <a href="<%= ResolveUrl("~/Frontend/Admin/TestConnection.aspx") %>">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <circle cx="12" cy="12" r="3"></circle>
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                    </svg>
                                    <span>DB Diagnostic</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <!-- Sidebar Footer Profile Block -->
                <div class="sidebar-footer">
                    <div class="user-avatar">
                        <asp:Literal ID="litAvatarInitials" runat="server" Text="AD" />
                    </div>
                    <div class="user-info">
                        <div class="user-name">
                            <asp:Literal ID="litAdminEmail" runat="server" Text="admin@university.edu" />
                        </div>
                        <div class="user-role">
                            <span class="role-dot"></span>
                            <span>Administrator</span>
                        </div>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout" OnClick="btnLogout_Click" ToolTip="Sign Out" CausesValidation="false">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </asp:LinkButton>
                </div>
            </aside>

            <!-- Main Working Area -->
            <div class="admin-main-wrapper">
                <!-- Topbar Header -->
                <header class="admin-topbar">
                    <div class="topbar-left">
                        <span class="topbar-title">University Event Management</span>
                        <div class="topbar-campus-tag">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Main Campus • Central Portal</span>
                        </div>
                    </div>

                    <div class="topbar-right">
                        <a href="<%= ResolveUrl("~/Frontend/User/Dashboard.aspx") %>" class="topbar-portal-link" title="Open Student Portal">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                            <span>Student Portal View</span>
                        </a>

                        <div class="system-pill">
                            <span class="system-pill-dot"></span>
                            <span>Database Online</span>
                        </div>
                    </div>
                </header>

                <asp:Panel ID="pnlPreviewBanner" runat="server" CssClass="preview-banner" Visible="false">
                    <div>
                        <strong>Preview Mode:</strong> You are viewing the UI layout without an active authenticated session.
                    </div>
                    <div>
                        <a href="<%= ResolveUrl("~/Frontend/Login/Login.aspx") %>">Go to Login Page &rarr;</a>
                    </div>
                </asp:Panel>

                <!-- Injected Child Content -->
                <main class="admin-workspace">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>
</body>
</html>
